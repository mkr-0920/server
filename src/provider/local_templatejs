// 假设这些模块与您的qq.js在同一目录或可访问的路径下
const select = require('./select');
const request = require('../request');
const { getManagedCacheStorage } = require('../cache');

/**
 * 将从API返回的单个本地歌曲数据格式化为内部标准格式
 * @param {object} songData - 从 /api/local/search 返回的 data 对象
 * @returns {object}
 */
const format = (songData) => {
    const parts = songData.title.split(' - ');
    const artist = parts.length > 1 ? parts[0].trim() : '未知艺术家';
    const name = parts.length > 1 ? parts[1].trim() : songData.title;

    return {
        id: songData.id,
        name: name,
        artist: artist,
        album: songData.album || '本地文件',
        duration: songData.duration_ms,
        downloadUrl: songData.download_url
    };
};

/**
 * 搜索本地音乐库（精确匹配模式）
 * @param {object} info - 包含精确关键词和可选专辑名的对象
 * @param {string} apiKey - 用于认证的API密钥
 * @returns {Promise<object>}
 */

const search = async (info) => {
    // 直接使用 info 中的信息，避免解析 keyword 字符串
    const songName = info.name.trim();
    const artist = info.artists.map(a => a.name).join('、').trim(); // 支持多位歌手

    // 构造标准格式："歌手 - 歌名"
    const searchQuery = `${artist} - ${songName}`;
    let url = 'https://cdn-musicapi.010920.xyz/api/local/search?q=' + encodeURIComponent(searchQuery);
    
    url += '&quality=master';

    const headers = {
        'X-API-Key': ''
    };

    const response = await request('GET', url, headers);
    const jsonBody = await response.json();

    if (jsonBody.code === 200 && jsonBody.data) {
        if (Array.isArray(jsonBody.data)) {
            const matchedSong = select(jsonBody.data, info);
            return format(matchedSong);
        } else {
            return format(jsonBody.data);
        }
    } else {
        throw new Error(jsonBody.error || '未找到本地歌曲');
    }
};

/**
 * 从已选出的歌曲对象中提取并构建完整的下载链接
 * @param {object} matchedSong - 从 search 函数返回的已匹配对象
 * @returns {Promise<string>}
 */
const track = async (matchedSong) => {
    const baseUrl = 'https://cdn-musicapi.010920.xyz';
    const fullUrl = baseUrl + matchedSong.downloadUrl;
    return fullUrl;
};



// 初始化本地音乐的缓存存储
const cs = getManagedCacheStorage('provider/local');
cs.aliveDuration = 24 * 60 * 60 * 1000; 

/**
 * 主检查函数，整合了缓存、搜索和链接提取
 * @param {object} info - 包含关键词、可选专辑名和时长的对象
 * @param {string} apiKey - API密钥
 */
const check = async (info) => {
    const matchedSong = await cs.cache(info, () => search(info));
    return track(matchedSong);
};

module.exports = { check, track };
